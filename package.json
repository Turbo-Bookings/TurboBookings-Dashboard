{
  "name": "turbobookings-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "fork": "node --env-file-if-exists=.env.local --import tsx scripts/fork.ts",
    "clerk:export-roles": "node --env-file-if-exists=.env.local --import tsx scripts/clerk-export-roles.ts",
    "clerk:import-roles": "node --env-file-if-exists=.env.local --import tsx scripts/clerk-import-roles.ts",
    "stripe:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/stripe-live-preflight.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@types/luxon": "^3.7.2",
    "@vercel/blob": "^2.4.0",
    "driver.js": "^1.8.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.22.0",
    "luxon": "^3.7.2",
    "next": "16.2.4",
    "node-vibrant": "^4.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
